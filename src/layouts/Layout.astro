---
import "../styles/global.css";

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Navigation principale">
        <a class:list={{ active: currentPath === "/" }} href="/">Accueil</a>
        <a
          class:list={{ active: currentPath === "/Penguins/Simple_penguins/" }}
          href="/Penguins/Simple_penguins/">Penguins</a
        >
        <a
          class:list={{ active: currentPath === "/Penguins/Penguins_filtre/" }}
          href="/Penguins/Penguins_filtre/">Filtre espèce</a
        >
        <a
          class:list={{
            active: currentPath === "/Penguins/Penguins_plusieurs_filtres/",
          }}
          href="/Penguins/Penguins_plusieurs_filtres/">Plusieurs filtres</a
        >
      </nav>
    </header>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .site-header {
    border-bottom: 1px solid #d9dee7;
    background: #ffffff;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    max-width: 960px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
  }

  a {
    padding: 0.55rem 0.8rem;
    border-radius: 0.45rem;
    color: #354052;
    font-size: 0.95rem;
    text-decoration: none;
  }

  a:hover,
  a.active {
    background: #e8f1ff;
    color: #1558a6;
  }

  @media (max-width: 520px) {
    nav {
      gap: 0.2rem;
      padding: 0.6rem;
    }

    a {
      font-size: 0.85rem;
    }
  }
</style>
