---
import Layout from "../../layouts/Layout.astro";
import diamonds from "../../assets/diamonds.json";
---

<Layout>
    <main class="data-page">
        <section class="data-intro">
            <p class="eyebrow">Diamond explorer</p>
            <h1>Filtre les diamonds</h1>
            <p class="intro-text">
                Choisis une coupe pour observer les diamonds correspondants.
            </p>
        </section>
        <section class="data-panel">
            <div class="data-heading">
                <div>
                    <p class="eyebrow">Filtre</p>
                    <h2>Choisir une coupe</h2>
                </div>
            </div>
            <form id="cut-form" class="data-filters">
                <label
                    >Coupe
                    <select name="cut" id="cut">
                        <option value="">All cuts</option>
                        <option value="Fair">Fair</option>
                        <option value="Good">Good</option>
                        <option value="Very Good">Very Good</option>
                        <option value="Premium">Premium</option>
                        <option value="Ideal">Ideal</option>
                    </select>
                </label>
            </form>
        </section>
        <section
            class="data-panel data-plot"
            aria-label="Graphique filtré des diamonds"
        >
            <div id="diamonds-plot" data-diamonds={JSON.stringify(diamonds)}>
            </div>
        </section>
    </main>

    <script>
        import * as Plot from "@observablehq/plot";

        const selectCut = document.querySelector<HTMLSelectElement>("#cut")!;
        const plotContainer =
            document.querySelector<HTMLDivElement>("#diamonds-plot")!;
        const diamonds = JSON.parse(plotContainer.dataset.diamonds ?? "[]");

        function renderPlot() {
            const cut = selectCut.value;
            const filteredDiamonds = cut
                ? diamonds.filter((diamond) => diamond.cut === cut)
                : diamonds;

            plotContainer.replaceChildren(
                Plot.plot({
                    marks: [
                        Plot.dot(filteredDiamonds, {
                            x: "carat",
                            y: "price",
                            stroke: "cut",
                        }),
                    ],
                }),
            );
        }

        selectCut.addEventListener("change", renderPlot);
        renderPlot();
    </script>
</Layout>
