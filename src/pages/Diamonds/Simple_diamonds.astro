---
import PlotFigure from "../../components/PlotFigure.astro";
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import diamonds from "../../assets/diamonds.json";
---

<Layout>
    <main class="data-page">
        <section class="data-intro">
            <p class="eyebrow">Diamond explorer</p>
            <h1>Découvre les diamonds</h1>
            <p class="intro-text">
                Observe le prix des diamonds selon leur poids et leur qualité de
                coupe.
            </p>
        </section>
        <section
            class="data-panel data-plot"
            aria-label="Graphique des diamonds"
        >
            <div class="data-heading">
                <div>
                    <p class="eyebrow">Visualisation</p>
                    <h2>Carat et prix par coupe</h2>
                </div>
            </div>
            <PlotFigure
                options={{
                    marks: [
                        Plot.dot(diamonds, {
                            x: "carat",
                            y: "price",
                            stroke: "cut",
                        }),
                    ],
                }}
            />
        </section>
    </main>
</Layout>
