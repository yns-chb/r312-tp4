---
import Layout from "../../layouts/Layout.astro";
import penguins from "../../assets/penguins.json";
---

<Layout>
    <main class="data-page">
        <section class="data-intro">
            <p class="eyebrow">Penguin explorer</p>
            <h1>Filtre les penguins</h1>
            <p class="intro-text">
                Choisis une espèce pour isoler ses mesures dans le graphique.
            </p>
        </section>
        <section class="data-panel">
            <div class="data-heading">
                <div>
                    <p class="eyebrow">Filtre</p>
                    <h2>Choisir une espèce</h2>
                </div>
            </div>
            <form id="species-form" class="data-filters">
                <label
                    >Espèce
                    <select name="species" id="species">
                        <option value="">All species</option>
                        <option value="Adelie">Adelie</option>
                        <option value="Chinstrap">Chinstrap</option>
                        <option value="Gentoo">Gentoo</option>
                    </select>
                </label>
            </form>
        </section>
        <section
            class="data-panel data-plot"
            aria-label="Graphique filtré des penguins"
        >
            <div id="penguins-plot" data-penguins={JSON.stringify(penguins)}>
            </div>
        </section>
    </main>

    <script>
        import * as Plot from "@observablehq/plot";

        const selectSpecies = document.querySelector("#species");
        const plotContainer = document.querySelector("#penguins-plot");
        const penguins = JSON.parse(plotContainer.dataset.penguins);

        function renderPlot() {
            const species = selectSpecies.value;
            const filteredPenguins = species
                ? penguins.filter((penguin) => penguin.species === species)
                : penguins;

            plotContainer.replaceChildren(
                Plot.plot({
                    marks: [
                        Plot.dot(filteredPenguins, {
                            x: "culmen_length_mm",
                            y: "culmen_depth_mm",
                            stroke: "species",
                        }),
                    ],
                }),
            );
        }

        selectSpecies.addEventListener("change", renderPlot);
        renderPlot();
    </script>
</Layout>
