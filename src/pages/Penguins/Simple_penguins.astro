---
import PlotFigure from "../../components/PlotFigure.astro";
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../../assets/penguins.json";
---

<Layout>
    <main class="data-page">
        <section class="data-intro">
            <p class="eyebrow">Penguin explorer</p>
            <h1>Découvre les penguins</h1>
            <p class="intro-text">
                Observe la relation entre la longueur et la profondeur du bec.
            </p>
        </section>
        <section
            class="data-panel data-plot"
            aria-label="Graphique des penguins"
        >
            <div class="data-heading">
                <div>
                    <p class="eyebrow">Visualisation</p>
                    <h2>Mesures du bec par espèce</h2>
                </div>
            </div>
            <PlotFigure
                options={{
                    marks: [
                        Plot.dot(penguins, {
                            x: "culmen_length_mm",
                            y: "culmen_depth_mm",
                            stroke: "species",
                        }),
                    ],
                }}
            />
        </section>
    </main>
</Layout>
